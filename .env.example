# Public site origin (no trailing slash) — used for canonicals, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://open-ai-engineering-standards.vercel.app

# Free analytics (optional — leave blank to disable)
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Umami (cloud.umami.is free tier or self-hosted)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Search Console / Bing / Yandex ownership tokens (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
