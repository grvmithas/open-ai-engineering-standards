{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaies.dev/schemas/conformance/evidence-1.0.0.json",
  "title": "OAIES Conformance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "generatedAt", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "assessmentId": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "controlId", "requirementId", "type", "uri", "digest", "observedAt", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "controlId": { "type": "string", "minLength": 1 },
          "requirementId": { "type": "string", "minLength": 1 },
          "type": { "enum": ["test", "attestation", "configuration", "trace", "review"] },
          "uri": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "observedAt": { "type": "string", "format": "date-time" },
          "validUntil": { "type": "string", "format": "date-time" },
          "result": { "enum": ["pass", "fail"] },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
