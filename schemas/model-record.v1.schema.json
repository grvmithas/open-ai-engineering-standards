{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ai-engineering-standard.org/schemas/v1/model-record.schema.json",
  "title": "AIES Model Record v1",
  "description": "Governed record for a first-party or third-party AI model version.",
  "type": "object",
  "required": ["schemaVersion", "id", "provider", "name", "version", "modelType", "source", "license", "intendedUses", "limitations", "dataGovernance", "evaluationRefs", "maximumImpactLevel", "approvalStatus", "owner", "recordedAt"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 100},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "string", "minLength": 1, "maxLength": 200},
    "modelType": {"enum": ["foundation", "fine-tuned", "embedding", "reranker", "classifier", "moderation", "multimodal", "other"]},
    "source": {
      "type": "object",
      "required": ["type", "uri", "integrityVerified"],
      "properties": {
        "type": {"enum": ["api", "registry", "repository", "internal-training"]},
        "uri": {"type": "string", "format": "uri"},
        "digest": {"$ref": "#/$defs/digest"},
        "integrityVerified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "license": {"type": "string", "minLength": 1, "maxLength": 200},
    "intendedUses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3, "maxLength": 500}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3, "maxLength": 1000}},
    "dataGovernance": {
      "type": "object",
      "required": ["trainingDataDisclosure", "personalDataPolicy", "retentionPolicy"],
      "properties": {
        "trainingDataDisclosure": {"enum": ["documented", "partially-documented", "undisclosed", "not-applicable"]},
        "personalDataPolicy": {"type": "string", "minLength": 10, "maxLength": 2000},
        "retentionPolicy": {"type": "string", "minLength": 10, "maxLength": 2000},
        "dataResidency": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 100}}
      },
      "additionalProperties": false
    },
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["text-input", "text-output", "image-input", "image-output", "audio-input", "audio-output", "video-input", "tool-use", "structured-output"]}},
    "evaluationRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri-reference"}},
    "maximumImpactLevel": {"enum": ["I0", "I1", "I2", "I3"]},
    "approvalStatus": {"enum": ["pending", "approved", "restricted", "rejected", "retired"]},
    "owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "deprecationAt": {"type": "string", "format": "date-time"},
    "recordedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^(?:sha256:[A-Fa-f0-9]{64}|sha384:[A-Fa-f0-9]{96}|sha512:[A-Fa-f0-9]{128})$"}
  }
}
