{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ai-engineering-standard.org/schemas/v1/risk-register.schema.json",
  "title": "OAIES Risk Register v1",
  "description": "Portfolio of traceable AI risks, treatments, ownership, and residual decisions.",
  "type": "object",
  "required": ["schemaVersion", "id", "systemRef", "systemVersion", "workloadProfiles", "autonomyLevel", "impactLevel", "method", "riskAppetite", "owner", "risks", "approvedAt", "nextReviewAt"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"},
    "systemRef": {"type": "string", "format": "uri-reference"},
    "systemVersion": {"type": "string", "minLength": 1, "maxLength": 200},
    "workloadProfiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["P1", "P2", "P3", "P4", "P5", "P6"]}},
    "autonomyLevel": {"enum": ["A0", "A1", "A2", "A3", "A4"]},
    "impactLevel": {"enum": ["I0", "I1", "I2", "I3"]},
    "method": {"type": "string", "minLength": 5, "maxLength": 1000},
    "riskAppetite": {"type": "string", "minLength": 10, "maxLength": 2000},
    "owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "scenario", "intendedUse", "foreseeableMisuse", "affectedParties", "affectedAssets", "inherent", "treatment", "residual", "disposition", "owner", "status", "identifiedAt", "nextReviewAt"],
        "properties": {
          "id": {"type": "string", "pattern": "^RISK-[A-Z0-9-]{3,64}$"},
          "title": {"type": "string", "minLength": 3, "maxLength": 200},
          "category": {"enum": ["safety", "security", "privacy", "fairness", "transparency", "reliability", "human-rights", "legal", "financial", "operational", "reputational", "supply-chain"]},
          "scenario": {"type": "string", "minLength": 10, "maxLength": 3000},
          "intendedUse": {"type": "string", "minLength": 3, "maxLength": 1000},
          "foreseeableMisuse": {"type": "string", "minLength": 3, "maxLength": 2000},
          "affectedParties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
          "affectedAssets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
          "inherent": {"$ref": "#/$defs/rating"},
          "treatment": {
            "type": "object",
            "required": ["strategy", "actions", "controlRefs"],
            "properties": {
              "strategy": {"enum": ["avoid", "mitigate", "transfer", "accept"]},
              "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5, "maxLength": 1000}},
              "controlRefs": {"type": "array", "items": {"$ref": "#/$defs/controlId"}}
            },
            "additionalProperties": false
          },
          "residual": {"$ref": "#/$defs/rating"},
          "disposition": {"enum": ["within-appetite", "accepted-by-authority", "requires-further-treatment", "prohibited"]},
          "owner": {"type": "string", "minLength": 1, "maxLength": 200},
          "status": {"enum": ["open", "treating", "monitoring", "accepted", "closed"]},
          "evidenceRefs": {"type": "array", "items": {"type": "string", "format": "uri-reference"}},
          "identifiedAt": {"type": "string", "format": "date-time"},
          "nextReviewAt": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "approvedAt": {"type": "string", "format": "date-time"},
    "nextReviewAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "rating": {
      "type": "object",
      "required": ["likelihood", "impact", "level", "rationale"],
      "properties": {
        "likelihood": {"enum": ["rare", "unlikely", "possible", "likely", "almost-certain"]},
        "impact": {"enum": ["I0", "I1", "I2", "I3"]},
        "level": {"enum": ["within-tolerance", "above-tolerance", "unacceptable"]},
        "rationale": {"type": "string", "minLength": 10, "maxLength": 2000}
      },
      "additionalProperties": false
    },
    "controlId": {"type": "string", "pattern": "^OAIES-(GOV|RSK|DAT|MOD|AGT|SEC|OPS|ASR)-[0-9]{3}[a-z]?$"}
  }
}
