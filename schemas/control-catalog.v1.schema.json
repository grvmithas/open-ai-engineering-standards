{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ai-engineering-standard.org/schemas/v1/control-catalog.schema.json",
  "title": "AIES Control Catalog v1",
  "description": "Versioned catalog of testable AI governance and engineering controls.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "status", "owner", "controls", "publishedAt"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "approved", "deprecated", "withdrawn"]},
    "owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "objective", "category", "priority", "applicability", "implementation", "verification", "evidenceRequirements", "failureAction"],
        "properties": {
          "id": {"$ref": "#/$defs/controlId"},
          "title": {"type": "string", "minLength": 3, "maxLength": 200},
          "objective": {"type": "string", "minLength": 10, "maxLength": 2000},
          "category": {"enum": ["governance", "risk", "data", "model", "agent", "security", "operations", "assurance"]},
          "priority": {"enum": ["mandatory", "risk-based", "recommended"]},
          "applicability": {
            "type": "object",
            "required": ["universal", "workloadProfiles", "autonomyLevels", "impactLevels", "condition"],
            "properties": {
              "universal": {"type": "boolean"},
              "workloadProfiles": {"type": "array", "uniqueItems": true, "items": {"enum": ["P1", "P2", "P3", "P4", "P5", "P6"]}},
              "autonomyLevels": {"type": "array", "uniqueItems": true, "items": {"enum": ["A0", "A1", "A2", "A3", "A4"]}},
              "impactLevels": {"type": "array", "uniqueItems": true, "items": {"enum": ["I0", "I1", "I2", "I3"]}},
              "condition": {"type": "string", "minLength": 3, "maxLength": 2000}
            },
            "additionalProperties": false
          },
          "implementation": {"type": "string", "minLength": 10, "maxLength": 4000},
          "verification": {"type": "string", "minLength": 10, "maxLength": 2000},
          "evidenceRequirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["evidenceClass", "description"],
              "properties": {
                "evidenceClass": {"enum": ["design", "implementation", "operation", "outcome"]},
                "description": {"type": "string", "minLength": 3, "maxLength": 1000}
              },
              "additionalProperties": false
            }
          },
          "failureAction": {"enum": ["block-release", "block-deployment", "disable-capability", "open-risk", "remediate-within-sla"]},
          "standardMappings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["framework", "reference", "relationship"],
              "properties": {
                "framework": {"type": "string", "minLength": 2, "maxLength": 100},
                "reference": {"type": "string", "minLength": 1, "maxLength": 200},
                "relationship": {"enum": ["evidence-supports", "partial", "no-mapping"]},
                "rationale": {"type": "string", "minLength": 5, "maxLength": 1000}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "publishedAt": {"type": "string", "format": "date-time"},
    "supersedes": {"type": "string", "format": "uri-reference"}
  },
  "additionalProperties": false,
  "$defs": {
    "controlId": {"type": "string", "pattern": "^AIES-(GOV|RSK|DAT|MOD|AGT|SEC|OPS|ASR)-[0-9]{3}[a-z]?$"}
  }
}
